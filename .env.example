# Copy to .env.local for local overrides. Every variable is optional in development.

# Postgres connection string. Leave empty locally to use the embedded PGlite database in .data/pglite.
# Production (Neon): use the *pooled* connection string, e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/menura?sslmode=require
DATABASE_URL=

# Required in production: 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL (no trailing slash). Used for QR codes, auth callbacks and emails.
APP_URL=http://localhost:3000

# Optional: enables "Şifremi unuttum" emails through Resend (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=Menura <noreply@your-domain.com>
